# patient-mobile env (Expo public vars — inlined at build time)
# Copy to .env and fill in per developer machine.

# Backend base URL (no trailing slash). Dev fallback is baked into
# src/config/api.ts so the app still runs without this file.
# Google login REQUIRES the hosted backend (Google blocks LAN/exp://):
# EXPO_PUBLIC_API_URL=https://hepziba-backend.vercel.app
EXPO_PUBLIC_API_URL=http://192.168.0.240:3000

# Google OAuth is backend-mediated — no frontend client IDs needed.
# The app opens <API>/auth/google/start; Google redirects to the backend
# callback; the backend redirects to patient-mobile://auth (or exp:// in dev).
# Remove any EXPO_PUBLIC_GOOGLE_* vars; they are ignored.

# Optional Cloudinary upload (profile photo). Leave blank for local-only mode
# where the picked image URI is stored directly as photo_url.
# Example: https://api.cloudinary.com/v1_1/<cloud-name>/image/upload
EXPO_PUBLIC_CLOUDINARY_URL=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
