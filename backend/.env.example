# .env example (placeholders only — never commit real secrets)
PORT=3000
DATABASE_URL=postgres://hepziba_user:H3pz1ba_2026@localhost:5432/hepziba
JWT_SECRET=your_super_secret_jwt_key
GOOGLE_CLIENT_ID=your_google_web_client_id
# Native/expo client IDs (id_token audience varies by platform — list them all).
# Only needed for the legacy direct POST /auth/google idToken flow.
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
GOOGLE_EXPO_CLIENT_ID=your_google_expo_client_id

# Backend-mediated Google OAuth (recommended — no Expo proxy, no frontend IDs).
# 1. In Google Cloud Console use ONE Web client (type=Web).
# 2. Add this exact URI under Authorized redirect URIs, then set the same
#    values here. BACKEND must be public HTTPS (Render/Railway/etc) —
#    Google blocks http:// LAN IPs and exp:// just like it blocked exp://.
#    Example: GOOGLE_REDIRECT_URI=https://your-api.onrender.com/auth/google/callback
GOOGLE_CLIENT_SECRET=your_google_web_client_secret
GOOGLE_REDIRECT_URI=https://your-api-host/auth/google/callback
# Where the backend sends the JWT after Google succeeds.
# Prod builds use the native scheme; Expo Go dev sends exp://... automatically.
MOBILE_GOOGLE_REDIRECT=patient-mobile://auth

# HTTPS email (preferred on networks that block outbound SMTP 587/465).
# Resend free tier: sign up at https://resend.com, create an API key, and set:
#   RESEND_API_KEY=re_xxx
#   RESEND_FROM="Hepziba <onboarding@resend.dev>"
# Notes: onboarding@resend.dev only delivers to the address used to sign up
# for Resend. For production, verify your own domain in Resend and use it as
# RESEND_FROM (e.g. "Hepziba <no-reply@yourdomain.com>").
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Outbound mail (nodemailer). Used only when RESEND_API_KEY is unset and
# SMTP_USER/SMTP_PASS are set. When neither is set, the mailer falls back
# to an Ethereal test account (dev only — never in production).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@example.com

# Public frontend base URL (used for links in emails, CORS allowlist).
FRONTEND_URL=http://localhost:5173

# Comma-separated CORS allowlist. When empty, only localhost origins
# (any port) are allowed — safe default for local dev.
CORS_ORIGIN=http://localhost:5173

# Session tokens: short-lived access JWT + rotating refresh tokens.
# Access default 15m (any jsonwebtoken expiresIn string); refresh default 30 days.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Serverless (Vercel) DB pooling. Keep 1 to avoid exhausting the
# Supabase pooler under concurrent lambdas. Local/Render can raise it.
DB_POOL_MAX=1

# Database session safety.
# db.js opens every connection with `-c timezone=UTC`. Some transaction-mode
# poolers reject that startup parameter; for those set DB_DISABLE_UTC_OPTIONS=1
# and configure the default at the role/database level:
#   ALTER ROLE <app_user> SET timezone = 'UTC';
#   ALTER DATABASE <db> SET timezone = 'UTC';
DB_DISABLE_UTC_OPTIONS=0
# Startup fails if SHOW TimeZone is not UTC. Set to 0 only for a temporary,
# explicitly accepted exception (the app will log a loud warning).
DB_REQUIRE_UTC=1
# Fail startup when migrations 005-010 objects are missing. Leave empty to
# default (strict when NODE_ENV=production, warn otherwise); set 1 to enforce
# locally, 0 to downgrade in production.
SCHEMA_STRICT=

# Appointment reminders (disabled by default).
# Minutes before the visit at which a durable reminder row is created and later
# delivered by the worker started in backend/index.js. Leave empty or 0 to
# disable. The value is stored as an absolute UTC TIMESTAMPTZ, so timezone and
# daylight-saving changes do not shift the reminder instant. Serverless
# deployments (api/index.js) must run the worker separately, for example:
#   node -e "require('./utils/reminders').processDueReminders()"
APPOINTMENT_REMINDER_OFFSET_MINUTES=

# Auth rate limits (requests per window). Relax for local testing if needed.
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX=50
AUTH_FORGOT_WINDOW_MS=900000
AUTH_FORGOT_MAX=10
AUTH_RESET_WINDOW_MS=900000
AUTH_RESET_MAX=20
